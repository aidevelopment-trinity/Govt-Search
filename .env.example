# Federal contract search. Keep the real value in .env.local locally and in
# Vercel project environment variables in production.
SAM_API_KEY=
# Optional: set to 1 only if you want broader SAM.gov searches that make more
# API calls per search. Leave unset for quota-safe production use.
SAM_EXPANDED_SEARCH=

# Optional site-wide password protection. Set these in Vercel to enable the
# browser password prompt.
APP_BASIC_AUTH_USERNAME=admin
APP_BASIC_AUTH_PASSWORD=

# Supabase will be added when the project is linked to the correct account.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for Vercel Cron to call /api/cron/gov-monitor.
CRON_SECRET=

# Optional email alerts for monitored keyword findings. Resend is the intended
# provider. Use onboarding@resend.dev only for provider smoke tests; production
# should use a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=Gov Contract Finder <alerts@your-domain.com>
EMAIL_REPLY_TO=
NEXT_PUBLIC_APP_URL=https://govt-search-web.vercel.app

# Optional Google Docs draft creation. Create a Google Cloud service account,
# enable Drive API and Docs API, share the target Drive folder with the service
# account email, then set these in Vercel.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DOC_REVIEWER_EMAIL=
